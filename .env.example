# Never commit .env or share these values.
O1_API_KEY=replace_with_a_new_o1_key
O1_API_URL=https://api.launch.o1.exchange/v1/tokens
O1_CHAIN_ID=8453
O1_LIST_LIMIT=50
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
# Chat/channel for NEW TOKEN alerts
TELEGRAM_CHAT_ID=replace_with_new_tokens_chat_id
# Separate chat/channel for $10k GROWTH alerts
TELEGRAM_GROWTH_CHAT_ID=replace_with_growth_chat_id
TELEGRAM_API_BASE=https://api.telegram.org
POLL_SECONDS=30
TRACK_INTERVAL_SECONDS=10
GROWTH_MC_THRESHOLD=10000
GROWTH_CONFIRMATION_SECONDS=0
MAX_TRACKING_TIME_MINUTES=30
TRACK_MAX_CONCURRENT_DETAIL=3
DATABASE_PATH=tokens.db
# mark_seen avoids sending old tokens on the first deployment; use send_all to send them.
INITIAL_SCAN=mark_seen
TEST_MESSAGE_ON_START=false
